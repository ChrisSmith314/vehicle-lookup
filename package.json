{
    "name": "chris_theme",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "watch:css": "tailwindcss -i ./assets/css/global.css -o ./src/global.css --watch",
        "watch:js": "esbuild assets/scripts/index.ts --bundle --outfile=src/global.js --watch",
        "dev": "concurrently npm:watch:css npm:watch:js",
        "build": "tailwindcss -i ./assets/css/global.css -o ./src/global.css --minify && esbuild assets/scripts/index.ts --bundle --outfile=src/global.js --minify"
    },
    "dependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "concurrently": "^10.0.6",
        "esbuild": "^0.28.2",
        "tailwindcss": "^4.3.3"
    }
}
